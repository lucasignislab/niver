---
const rows = [
  {
    direction: "marquee-right-to-left",
    avatarSize: "clamp(64px, 7.292vw, 72px)",
    cardWidth: "clamp(220px, 39.0625vw, 340px)",
    profiles: [
      { name: "Tarcísio Bianchi", instagram: "@tarcisiobianchii", image: "/assets/mentores-01.webp", imageOffset: 0 },
      { name: "Michael Pogne", instagram: "@michael.pogne", image: "/assets/mentores-01.webp", imageOffset: -344 / 62 },
      { name: "Tayna Gauche", instagram: "@taynagauche", image: "/assets/mentores-01.webp", imageOffset: -680 / 62 },
      { name: "Yury Ferreira", instagram: "@yuryferreira.ads", image: "/assets/yury-ferreira.webp", imageOffset: null },
      { name: "Robson Abreu", instagram: "@robsonabreu.ads", image: "/assets/robson-abreu.webp", imageOffset: null },
      { name: "André Xavier", instagram: "@andrexavier.ads", image: "/assets/andre-xavier.webp", imageOffset: null },
      { name: "Edvaldo Anjos", instagram: "@edvadoanjoss", image: "/assets/edvaldo-anjos.webp", imageOffset: null },
      { name: "Dairo Junior", instagram: null, image: "/assets/dairo-junior.webp", imageOffset: null, avatarTransform: "translateY(14%) scale(1.15)" },
      { name: "Luciano Lomeu", instagram: "@lomeuluciano", image: null, imageOffset: null, initials: "LL" },
      { name: "Bruno Borges", instagram: "@brunobrogiez", image: "/assets/bruno-borges.webp", imageOffset: null, avatarTransform: "scale(1.5)" },
    ],
  },
  {
    direction: "marquee-left-to-right",
    avatarSize: "clamp(64px, 7.292vw, 72px)",
    cardWidth: "clamp(170px, 33.854vw, 300px)",
    profiles: [
      { name: "Leo Rodrigues", instagram: "@leorodrigues.dollar", image: "/assets/mentores-02.webp", imageOffset: 0 },
      { name: "Bruno Matos", instagram: "@bruno.omatos", image: "/assets/mentores-02.webp", imageOffset: -344 / 64 },
      { name: "Ronaldo Ibrahim", instagram: "@ronaldoibrahim.ads", image: "/assets/mentores-02.webp", imageOffset: -680 / 64 },
      { name: "Amanda Gomes", instagram: "@amandagomes.ads", image: "/assets/amanda-gomes.webp", imageOffset: null },
      { name: "Maurício Brollo", instagram: "@dombrollo", image: "/assets/mauricio-brollo.webp", imageOffset: null },
      { name: "Davy Marcelo", instagram: "@eudavymarcelo", image: "/assets/davy-marcelo.webp", imageOffset: null, avatarTransform: "scale(0.82)" },
      { name: "Lígia de Souza", instagram: "@ligiadesouzaoficiaa", image: "/assets/ligia-de-souza.webp", imageOffset: null, avatarTransform: "scale(1.25)" },
      { name: "Clarissa Aguiar", instagram: "@claaguiar.ads", image: "/assets/clarissa-aguiar.webp", imageOffset: null, avatarTransform: "translateY(15%) scale(1.2)" },
      { name: "Lidi & Fran", instagram: "@casaldoasoficial", image: null, imageOffset: null, initials: "L&F" },
    ],
  },
];
---

<section class="py-12 bg-brand-lighter overflow-hidden border-b border-black/5">
  <div class="container mx-auto px-4 mb-12">
    <div class="flex items-center justify-center gap-4 md:gap-8 overflow-hidden whitespace-nowrap">
      <div class="h-px bg-black/10 grow max-w-[200px]"></div>
      <h2 class="text-[10px] md:text-xs font-black text-gray-400 uppercase tracking-[0.3em] shrink-0">
        QUEM JÁ UTILIZA A RATOEIRA
      </h2>
      <div class="h-px bg-black/10 grow max-w-[200px]"></div>
    </div>
  </div>

  <div class="space-y-8 relative">
    {rows.map(({ direction, avatarSize, cardWidth, profiles }) => (
      <div class={`marquee-container ${direction}`} style={`--avatar-size:${avatarSize};--card-width:${cardWidth};`}>
        <div class="marquee-inner flex">
          {[0, 1, 2, 3].map((repetition) => (
            <div class="flex shrink-0" aria-hidden={repetition > 0}>
              {profiles.map((profile) => (
                <div class="mentor-card flex shrink-0 items-center gap-3" style="width:var(--card-width);height:var(--avatar-size);">
                  <div class="mentor-avatar relative flex shrink-0 items-center justify-center overflow-hidden rounded-full bg-brand-yellow text-lg font-black text-brand-dark" style="width:var(--avatar-size);height:var(--avatar-size);">
                    {profile.image ? (
                      <img
                        src={profile.image}
                        alt=""
                        class={profile.imageOffset === null ? "h-full w-full object-cover object-top" : "absolute top-0 h-full w-auto max-w-none"}
                        style={profile.imageOffset === null ? "avatarTransform" in profile ? `transform: ${profile.avatarTransform};` : undefined : `left: calc(var(--avatar-size) * ${profile.imageOffset});`}
                      />
                    ) : "initials" in profile ? profile.initials : null}
                  </div>
                  <div class="min-w-0 whitespace-nowrap leading-none">
                    <span class="block text-xs font-black uppercase text-brand-dark md:text-lg lg:text-xl">{profile.name}</span>
                    {profile.instagram && <span class="mt-0.5 block text-[8px] font-bold uppercase text-gray-500 md:text-xs">{profile.instagram}</span>}
                  </div>
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .marquee-container {
    mask-image: linear-gradient(to right, transparent, black 3%, black 97%, transparent);
    overflow: hidden;
    width: 100%;
  }

  .marquee-inner {
    width: fit-content;
  }

  @keyframes marqueeLeft {
    0% { transform: translateX(0); }
    100% { transform: translateX(-25%); }
  }

  @keyframes marqueeRight {
    0% { transform: translateX(-25%); }
    100% { transform: translateX(0); }
  }

  .marquee-right-to-left .marquee-inner {
    animation: marqueeLeft 40s linear infinite;
  }

  .marquee-left-to-right .marquee-inner {
    animation: marqueeRight 50s linear infinite;
    margin-top: 1rem;
  }

  @media (min-width: 768px) {
    .marquee-left-to-right .marquee-inner {
      margin-top: 0;
    }
  }

  @media (max-width: 767px) {
    .marquee-right-to-left .marquee-inner {
      animation-duration: 25s;
    }

    .marquee-left-to-right .marquee-inner {
      animation-duration: 30s;
    }
  }
</style>
