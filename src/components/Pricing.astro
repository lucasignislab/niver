<script>
  const DISABLE_POPUP_CHECKOUT_LINKS = false;

  function initPricing() {
    const bundleBtns = document.querySelectorAll("[data-bundle-trigger]");
    const periodBtns = document.querySelectorAll("[data-period-trigger]");
    const bundleGroups = document.querySelectorAll("[data-bundle-group]");

    let currentBundle = "combo";
    let currentPeriod = "anual";

    function updateView() {
      // 1. Filter Bundle
      bundleGroups.forEach((group) => {
        const el = group as HTMLElement;
        if (el.getAttribute("data-bundle-group") === currentBundle) {
          el.style.display = "block";
          el.classList.remove("opacity-0", "scale-95");
        } else {
          el.style.display = "none";
          el.classList.add("opacity-0", "scale-95");
        }
      });

      // 2. Filter Period within active Bundle
      const activeBundle = document.querySelector(
        `[data-bundle-group="${currentBundle}"]`,
      ) as HTMLElement;
      if (activeBundle) {
        const isMobile = window.innerWidth < 768;
        const pGroups = activeBundle.querySelectorAll("[data-period-group]");
        pGroups.forEach((pg) => {
          const el = pg as HTMLElement;
          if (el.getAttribute("data-period-group") === currentPeriod) {
            // No mobile, usa flex para o scroll-snap funcionar; no desktop, grid
            el.style.display = isMobile ? "flex" : "grid";
            el.classList.remove("opacity-0", "scale-95");
          } else {
            el.style.display = "none";
            el.classList.add("opacity-0", "scale-95");
          }
        });
      }

      updateDynamicPrices();
    }

    // Bundle Listeners
    bundleBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const val = btn.getAttribute("data-bundle-trigger");
        if (val) currentBundle = val;
        bundleBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        updateView();
      });
    });

    // Period Listeners
    periodBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const val = btn.getAttribute("data-period-trigger");
        if (val) currentPeriod = val;
        periodBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        updateView();
      });
    });

    // Run initial update
    updateView();
  }

  // Initial load
  initPricing();
  updateDynamicPrices();
  initCheckoutPopup();
  initMobileNavigation();

  function initPriceAutoRefresh() {
    const win = window as any;

    if (win.__pricingRefreshInterval) {
      clearInterval(win.__pricingRefreshInterval);
    }

    win.__pricingRefreshInterval = window.setInterval(
      updateDynamicPrices,
      15000,
    );

    if (!win.__pricingVisibilityHooked) {
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") {
          updateDynamicPrices();
        }
      });
      window.addEventListener("focus", updateDynamicPrices);
      win.__pricingVisibilityHooked = true;
    }
  }

  initPriceAutoRefresh();

  function getSaoPauloDateKey() {
    const parts = new Intl.DateTimeFormat("en-US", {
      timeZone: "America/Sao_Paulo",
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }).formatToParts(new Date());

    const year = parts.find((p) => p.type === "year")?.value ?? "";
    const month = parts.find((p) => p.type === "month")?.value ?? "";
    const day = parts.find((p) => p.type === "day")?.value ?? "";

    return `${year}-${month}-${day}`;
  }

  function getPromoCheckoutCoupon() {
    const dateKey = getSaoPauloDateKey();
    const couponByDate: Record<string, string> = {
      "2026-04-30": "NIVER25",
    };
    return couponByDate[dateKey] || "NIVER25";
  }

  function extractUtmParams() {
    const url = new URL(window.location.href);
    const utmKeys = [
      "utm_source",
      "utm_medium",
      "utm_campaign",
      "utm_term",
      "utm_content",
    ];
    const result: Record<string, string> = {};
    utmKeys.forEach((key) => {
      const value = url.searchParams.get(key);
      if (value) result[key] = value;
    });
    return result;
  }

  function buildQueryString(params: Array<[string, string]>) {
    return params
      .filter(
        ([, value]) => value !== undefined && value !== null && value !== "",
      )
      .map(
        ([key, value]) =>
          `${encodeURIComponent(key)}=${encodeURIComponent(value)}`,
      )
      .join("&");
  }

  function splitPhone(rawPhone: string) {
    const digits = rawPhone.replace(/\D/g, "");
    if (digits.length < 10) {
      return { phoneLocalCode: "", phone: "" };
    }
    if (digits.length > 11) {
      const ddiLength = digits.length - 11;
      return {
        phoneLocalCode: digits.slice(0, ddiLength),
        phone: digits.slice(ddiLength),
      };
    }
    return {
      phoneLocalCode: "55",
      phone: digits,
    };
  }

  function initCheckoutPopup() {
    const win = window as any;
    if (win.__checkoutPopupHooked) return;
    win.__checkoutPopupHooked = true;

    const closePopup = () => {
      const popup = document.getElementById("checkout-popup");
      if (!popup) return;
      popup.classList.add("hidden");
      popup.classList.remove("flex");
      document.body.classList.remove("overflow-hidden");
    };

    const openPopup = (
      checkoutTarget: string,
      checkoutTrigger: HTMLAnchorElement,
    ) => {
      const popup = document.getElementById("checkout-popup");
      const form = document.getElementById(
        "checkout-popup-form",
      ) as HTMLFormElement | null;
      if (!popup || !form) return;
      const periodGroup = checkoutTrigger.closest(
        "[data-period-group]",
      ) as HTMLElement | null;
      const bundleGroup = checkoutTrigger.closest(
        "[data-bundle-group]",
      ) as HTMLElement | null;
      form.dataset.checkoutTarget = checkoutTarget;
      form.dataset.checkoutPeriod =
        periodGroup?.getAttribute("data-period-group") || "";
      form.dataset.checkoutBundle =
        bundleGroup?.getAttribute("data-bundle-group") || "";
      form.dataset.checkoutButtonId =
        checkoutTrigger.id ||
        `${form.dataset.checkoutBundle || "bundle"}-${form.dataset.checkoutPeriod || "period"}-assinar`;
      const submitButton = form.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement | null;
      if (submitButton) {
        if (DISABLE_POPUP_CHECKOUT_LINKS) {
          submitButton.disabled = true;
          submitButton.textContent = "Checkout indisponivel";
          submitButton.classList.add("opacity-60", "cursor-not-allowed");
        } else {
          submitButton.disabled = false;
          submitButton.textContent = "Ir para checkout";
          submitButton.classList.remove("opacity-60", "cursor-not-allowed");
        }
      }
      popup.classList.remove("hidden");
      popup.classList.add("flex");
      document.body.classList.add("overflow-hidden");
      const firstInput = form.querySelector(
        'input[name="name"]',
      ) as HTMLInputElement | null;
      firstInput?.focus();
    };

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;

      const closeTrigger = target.closest(
        "[data-popup-close]",
      ) as HTMLElement | null;
      if (closeTrigger) {
        closePopup();
        return;
      }

      const checkoutTrigger = target.closest(
        "#planos [data-period-group] a[href]",
      ) as HTMLAnchorElement | null;
      if (!checkoutTrigger) return;
      event.preventDefault();
      openPopup(checkoutTrigger.getAttribute("href") || "#", checkoutTrigger);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closePopup();
      }
    });

    document.addEventListener("submit", async (event) => {
      const form = event.target as HTMLFormElement | null;
      if (!form || form.id !== "checkout-popup-form") return;
      event.preventDefault();
      if (DISABLE_POPUP_CHECKOUT_LINKS) {
        closePopup();
        return;
      }
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const checkoutTarget = form.dataset.checkoutTarget || "#";
      const name = (
        (form.querySelector('input[name="name"]') as HTMLInputElement | null)
          ?.value || ""
      ).trim();
      const email = (
        (form.querySelector('input[name="email"]') as HTMLInputElement | null)
          ?.value || ""
      ).trim();
      const rawPhone = (
        (form.querySelector('input[name="phone"]') as HTMLInputElement | null)
          ?.value || ""
      ).trim();
      const phoneParts = splitPhone(rawPhone);
      const phoneInput = form.querySelector(
        'input[name="phone"]',
      ) as HTMLInputElement | null;

      if (!phoneParts.phoneLocalCode || !phoneParts.phone) {
        if (phoneInput) {
          phoneInput.setCustomValidity(
            "Informe telefone com DDI, DDD e número.",
          );
          form.reportValidity();
          phoneInput.setCustomValidity("");
        }
        return;
      }

      const isVitalicio = (form.dataset.checkoutPeriod || "") === "vitalicio";
      const utms = extractUtmParams();
      const checkoutUrl = new URL(checkoutTarget, window.location.origin);

      // Mescla parâmetros básicos, UTMs e o cupom
      checkoutUrl.searchParams.set("name", name);
      checkoutUrl.searchParams.set(
        "phone_local_code",
        phoneParts.phoneLocalCode,
      );
      checkoutUrl.searchParams.set("phone", phoneParts.phone);
      checkoutUrl.searchParams.set("email", email);
      checkoutUrl.searchParams.set("id_forms", form.id);
      checkoutUrl.searchParams.set(
        "id_botao",
        form.dataset.checkoutButtonId || "",
      );

      Object.entries(utms).forEach(([key, value]) => {
        if (value) checkoutUrl.searchParams.set(key, value);
      });

      if (!isVitalicio) {
        checkoutUrl.searchParams.set("coupon", getPromoCheckoutCoupon());
      }

      const redirectUrl = checkoutUrl.toString();

      const webhookPayload: Record<string, string> = {
        checkout_url: checkoutTarget,
        checkout_url_com_dados: redirectUrl,
        bundle: form.dataset.checkoutBundle || "",
        period: form.dataset.checkoutPeriod || "",
        id_forms: form.id,
        id_botao: form.dataset.checkoutButtonId || "",
        name,
        email,
        phone_local_code: phoneParts.phoneLocalCode,
        phone: phoneParts.phone,
        utm_source: utms.utm_source || "",
        utm_medium: utms.utm_medium || "",
        utm_campaign: utms.utm_campaign || "",
        utm_term: utms.utm_term || "",
        utm_content: utms.utm_content || "",
      };

      if (!isVitalicio) {
        webhookPayload.coupon = getPromoCheckoutCoupon();
      }

      try {
        const webhookRequest = fetch(
          "https://n8n.srv1145908.hstgr.cloud/webhook/checkout-niver-2-anos",
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(webhookPayload),
            mode: "cors",
            keepalive: true,
          },
        ).catch(() => null);
        await Promise.race([
          webhookRequest,
          new Promise((resolve) => setTimeout(resolve, 800)),
        ]);
      } catch {}

      closePopup();
      window.location.href = redirectUrl;
    });
  }

  function initMobileNavigation() {
    const prevBtn = document.getElementById('pricing-prev');
    const nextBtn = document.getElementById('pricing-next');
    if (!prevBtn || !nextBtn) return;

    const getActiveGroup = () =>
      Array.from(document.querySelectorAll('.period-group')).find(
        (el) => (el as HTMLElement).offsetParent !== null,
      ) as HTMLElement | undefined;

    const getCards = (group: HTMLElement) =>
      Array.from(group.children).filter(
        (el): el is HTMLElement => el instanceof HTMLElement,
      );

    const getNearestCardIndex = (
      group: HTMLElement,
      cards: HTMLElement[],
    ): number => {
      if (!cards.length) return 0;
      const viewportCenter = group.scrollLeft + group.clientWidth / 2;
      let nearestIndex = 0;
      let minDistance = Number.POSITIVE_INFINITY;

      cards.forEach((card, index) => {
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
        const distance = Math.abs(cardCenter - viewportCenter);
        if (distance < minDistance) {
          minDistance = distance;
          nearestIndex = index;
        }
      });

      return nearestIndex;
    };

    const scrollToCard = (group: HTMLElement, card: HTMLElement) => {
      const left = card.offsetLeft - (group.clientWidth - card.offsetWidth) / 2;
      group.scrollTo({ left: Math.max(0, left), behavior: 'smooth' });
    };

    const updateArrowsVisibility = () => {
      const activeGroup = getActiveGroup();
      if (!activeGroup) return;

      const isScrollable = activeGroup.scrollWidth > activeGroup.clientWidth + 5;
      
      if (!isScrollable) {
        prevBtn.style.display = 'none';
        nextBtn.style.display = 'none';
        return;
      }

      const scrollLeft = activeGroup.scrollLeft;
      const maxScroll = activeGroup.scrollWidth - activeGroup.clientWidth;

      // Manter setas sempre visíveis, mudando apenas opacidade e interatividade
      prevBtn.style.display = 'flex';
      nextBtn.style.display = 'flex';

      if (scrollLeft <= 5) {
        prevBtn.classList.add('opacity-20');
        prevBtn.classList.remove('opacity-100');
        (prevBtn as HTMLElement).style.pointerEvents = 'none';
      } else {
        prevBtn.classList.remove('opacity-20');
        prevBtn.classList.add('opacity-100');
        (prevBtn as HTMLElement).style.pointerEvents = 'auto';
      }

      if (scrollLeft >= maxScroll - 5) {
        nextBtn.classList.add('opacity-20');
        nextBtn.classList.remove('opacity-100');
        (nextBtn as HTMLElement).style.pointerEvents = 'none';
      } else {
        nextBtn.classList.remove('opacity-20');
        nextBtn.classList.add('opacity-100');
        (nextBtn as HTMLElement).style.pointerEvents = 'auto';
      }
    };

    prevBtn.addEventListener('click', () => {
      const activeGroup = getActiveGroup();
      if (!activeGroup) return;
      const cards = getCards(activeGroup);
      if (!cards.length) return;
      const currentIndex = getNearestCardIndex(activeGroup, cards);
      const targetIndex = Math.max(0, currentIndex - 1);
      scrollToCard(activeGroup, cards[targetIndex]);
      setTimeout(updateArrowsVisibility, 400);
    });

    nextBtn.addEventListener('click', () => {
      const activeGroup = getActiveGroup();
      if (!activeGroup) return;
      const cards = getCards(activeGroup);
      if (!cards.length) return;
      const currentIndex = getNearestCardIndex(activeGroup, cards);
      const targetIndex = Math.min(cards.length - 1, currentIndex + 1);
      scrollToCard(activeGroup, cards[targetIndex]);
      setTimeout(updateArrowsVisibility, 400);
    });

    // Detect group changes
    const observer = new MutationObserver(() => {
      setTimeout(updateArrowsVisibility, 150);
    });

    const pricingContent = document.querySelector('.pricing-content');
    if (pricingContent) {
      observer.observe(pricingContent, { attributes: true, subtree: true, attributeFilter: ['style', 'class'] });
    }

    // Scroll listeners for all groups
    document.querySelectorAll('.period-group').forEach(group => {
      group.addEventListener('scroll', () => updateArrowsVisibility(), { passive: true });
    });

    window.addEventListener('resize', updateArrowsVisibility);
    
    // Gatilhos imediatos e posteriores para garantir o carregamento
    updateArrowsVisibility();
    setTimeout(updateArrowsVisibility, 100);
    setTimeout(updateArrowsVisibility, 500);
    setTimeout(updateArrowsVisibility, 1500);
  }

  function removeCardDiscountCounters() {
    const allBadges = document.querySelectorAll("#planos .card-discount-badge");
    allBadges.forEach((b) => b.remove());
  }

  function normalizeBadgeContrast() {
    const priceBadgeValues = document.querySelectorAll(
      "#planos [data-price-calc], #planos [data-price-vitalicio]",
    );

    priceBadgeValues.forEach((valueEl) => {
      const hostCard = (valueEl as HTMLElement).closest(".relative");
      const badge = (valueEl as HTMLElement).closest("div");
      if (!hostCard || !badge) return;

      const isDarkCard = hostCard.classList.contains("bg-black");
      badge.classList.remove(
        "text-white",
        "text-white/70",
        "text-brand-dark/60",
        "text-brand-dark/70",
      );
      badge.classList.remove("bg-brand-yellow/10", "bg-brand-yellow/25");
      badge.classList.remove("border", "border-brand-yellow/40");

      if (isDarkCard) {
        badge.classList.add(
          "text-white",
          "bg-brand-yellow/25",
          "border",
          "border-brand-yellow/40",
        );
      } else {
        badge.classList.add("text-brand-dark/70", "bg-brand-yellow/10");
      }
    });
  }

  // Pricing Dynamic Logic
  function updateDynamicPrices() {
    const getNowSP = () => new Date(new Date().toLocaleString("en-US", { timeZone: "America/Sao_Paulo" }));
    const now = getNowSP();
    const dateKey = getSaoPauloDateKey();
    
    // Campanha reaberta: 30/04/2026 00:00 até 01/05/2026 08:00 (São Paulo)
    const campaignStartAt = new Date("2026-04-30T00:00:00-03:00").getTime();
    const campaignEndAt = new Date("2026-05-01T08:00:00-03:00").getTime();
    
    const discountSchedule: Record<string, { discount: number; coupon: string }> = {
      "2026-04-30": { discount: 25, coupon: "NIVER25" },
    };

    // Determinar estado atual
    let currentDiscount = 25;
    let currentCoupon = "NIVER25";
    let isLocked = false;

    if (now.getTime() < campaignStartAt) {
      isLocked = true;
      currentDiscount = 25;
      currentCoupon = "NIVER25";
    } else if (now.getTime() >= campaignEndAt) {
      isLocked = true;
      currentDiscount = 25;
      currentCoupon = "NIVER25";
    } else {
      const dayInfo = discountSchedule[dateKey];
      if (dayInfo) {
        currentDiscount = dayInfo.discount;
        currentCoupon = dayInfo.coupon;
      }
      isLocked = false;
    }

    // Bloqueio Global de Botões
    const pricingContent = document.querySelector('.pricing-content');
    if (pricingContent) {
      const allButtons = pricingContent.querySelectorAll('a[href], button:not(.period-btn):not(.bundle-btn)');
      allButtons.forEach(btn => {
        if (isLocked) {
          btn.classList.add('is-locked-btn');
          if (btn.tagName === 'BUTTON') (btn as HTMLButtonElement).disabled = true;
          if (btn.tagName === 'A') btn.setAttribute('onclick', 'return false;');
        } else {
          btn.classList.remove('is-locked-btn');
          if (btn.tagName === 'BUTTON') (btn as HTMLButtonElement).disabled = false;
          if (btn.tagName === 'A') btn.removeAttribute('onclick');
        }
      });
    }

    // Base de Preços
    const pricingData: Record<string, Record<string, Record<string, number>>> = {
      ads: {
        mensal: { rato: 167, ratazana: 247, "ratazana-plus": 397 },
        semestral: { rato: 797, ratazana: 1097, "ratazana-plus": 2097 },
        anual: { rato: 1347, ratazana: 1797, "ratazana-plus": 3997 },
      },
      combo: {
        mensal: { rato: 197, ratazana: 297, "ratazana-plus": 497 },
        semestral: { rato: 1097, ratazana: 1597, "ratazana-plus": 2597 },
        anual: { rato: 1897, ratazana: 2597, "ratazana-plus": 4997 },
      },
      pages: {
        mensal: { rato: 177, ratazana: 197, "ratazana-plus": 247 },
        semestral: { rato: 497, ratazana: 597, "ratazana-plus": 797 },
        anual: { rato: 657, ratazana: 877, "ratazana-plus": 1397 },
      },
    };

    const parcelPricingData: Record<string, Record<string, Record<string, number>>> = {
      ads: {
        mensal: { rato: 167, ratazana: 247, "ratazana-plus": 397 },
        semestral: { rato: 149.52, ratazana: 205.7, "ratazana-plus": 349.5 },
        anual: { rato: 139.31, ratazana: 185.85, "ratazana-plus": 333.08 },
      },
      combo: {
        mensal: { rato: 197, ratazana: 297, "ratazana-plus": 497 },
        semestral: { rato: 182.83, ratazana: 266.17, "ratazana-plus": 432.83 },
        anual: { rato: 158.08, ratazana: 216.42, "ratazana-plus": 416.42 },
      },
      pages: {
        mensal: { rato: 177, ratazana: 197, "ratazana-plus": 247 },
        semestral: { rato: 93.24, ratazana: 112, "ratazana-plus": 149.52 },
        anual: { rato: 67.95, ratazana: 90.7, "ratazana-plus": 144.48 },
      },
    };

    const vitalicioPricing = { ads: 3997, combo: 5497, pages: 1797 };

    const calculatePrice = (base: number) => {
      return Number((base * (1 - currentDiscount / 100)).toFixed(2));
    };

    const adsVitalicioSchedule: Record<string, number> = {
      "2026-04-13": 3497,
      "2026-04-14": 3597,
      "2026-04-15": 3697,
      "2026-04-16": 3747,
      "2026-04-17": 3797,
      "2026-04-18": 3897,
      "2026-04-19": 3997,
    };

    const pagesVitalicioSchedule: Record<string, number> = {
      "2026-04-13": 1500,
      "2026-04-14": 1547,
      "2026-04-15": 1597,
      "2026-04-16": 1647,
      "2026-04-17": 1697,
      "2026-04-18": 1747,
      "2026-04-19": 1797,
    };

    const comboVitalicioSchedule: Record<string, number> = {
      "2026-04-13": 4997,
      "2026-04-14": 5097,
      "2026-04-15": 5197,
      "2026-04-16": 5247,
      "2026-04-17": 5297,
      "2026-04-18": 5397,
      "2026-04-19": 5497,
    };

    const adsVitalicioDateKey =
      dateKey < "2026-04-13"
        ? "2026-04-13"
        : dateKey > "2026-04-19"
          ? "2026-04-19"
          : dateKey;

    // Atualização da UI
    document.querySelectorAll("[data-price-calc], [data-price-vitalicio], [data-price-vitalicio-parcel], [data-price-parcel-calc], [data-price-calc-main]").forEach((el) => {
      const bundle = el.getAttribute("data-bundle") || el.getAttribute("data-calc-bundle");
      const period = el.getAttribute("data-period") || el.getAttribute("data-calc-period");
      const plan = el.getAttribute("data-plan") || el.getAttribute("data-calc-plan");

      if (el.hasAttribute("data-price-vitalicio")) {
        const base = (vitalicioPricing as any)[bundle!];
        const final =
          bundle === "ads" && adsVitalicioSchedule[adsVitalicioDateKey]
            ? adsVitalicioSchedule[adsVitalicioDateKey]
            : bundle === "combo" && comboVitalicioSchedule[adsVitalicioDateKey]
              ? comboVitalicioSchedule[adsVitalicioDateKey]
            : bundle === "pages" && pagesVitalicioSchedule[adsVitalicioDateKey]
              ? pagesVitalicioSchedule[adsVitalicioDateKey]
            : calculatePrice(base);
        el.textContent = `R$ ${final.toFixed(2).replace(".", ",")}`;
        return;
      }

      if (el.hasAttribute("data-price-vitalicio-parcel") || el.hasAttribute("data-price-parcel-calc")) {
        const base = el.hasAttribute("data-price-vitalicio-parcel") 
          ? (vitalicioPricing as any)[bundle!]
          : pricingData[bundle!]?.[period!]?.[plan!];
          
        if (!base) return;
        const finalBase =
          el.hasAttribute("data-price-vitalicio-parcel") &&
          bundle === "ads" &&
          adsVitalicioSchedule[adsVitalicioDateKey]
            ? adsVitalicioSchedule[adsVitalicioDateKey]
            : el.hasAttribute("data-price-vitalicio-parcel") &&
              bundle === "combo" &&
              comboVitalicioSchedule[adsVitalicioDateKey]
              ? comboVitalicioSchedule[adsVitalicioDateKey]
            : el.hasAttribute("data-price-vitalicio-parcel") &&
              bundle === "pages" &&
              pagesVitalicioSchedule[adsVitalicioDateKey]
              ? pagesVitalicioSchedule[adsVitalicioDateKey]
            : calculatePrice(base);
        const installments = (period === "anual" || el.hasAttribute("data-price-vitalicio-parcel")) ? 12 : period === "semestral" ? 6 : 1;

        const customParcelBase =
          !el.hasAttribute("data-price-vitalicio-parcel") &&
          (bundle === "ads" || bundle === "combo" || bundle === "pages") &&
          period &&
          plan
            ? parcelPricingData[bundle]?.[period]?.[plan]
            : null;
        const parcelValue =
          customParcelBase !== null && customParcelBase !== undefined
            ? calculatePrice(customParcelBase)
            : finalBase / installments;
        const parcel = parcelValue.toFixed(2).replace(".", ",");
        
        if (installments > 1) {
          el.textContent = `${installments}x R$ ${parcel}`;
        } else {
          el.textContent = `R$ ${parcel}`;
        }
        return;
      }

      if (!bundle || !period || !plan) return;

      const basePrice = pricingData[bundle]?.[period]?.[plan];
      if (basePrice) {
        const finalPrice = calculatePrice(basePrice);
        const card = el.closest(".relative");
        const isDarkCard = card?.classList.contains("bg-black");
        const strikeClass = isDarkCard ? "text-white/50" : "text-brand-dark/40";

        el.innerHTML = `
          <span class="text-sm ${strikeClass} line-through block -mb-1">De R$ ${basePrice.toFixed(2).replace(".", ",")}</span>
          R$ ${finalPrice.toFixed(2).replace(".", ",")}
        `;

        // Sincronizar Cupom no Checkout
        if (card && !isLocked) {
          const checkoutLink = card.querySelector("a[href]");
          if (checkoutLink) {
            try {
              const url = new URL(checkoutLink.getAttribute("href")!);
              url.searchParams.set("off", currentCoupon);
              checkoutLink.setAttribute("href", url.toString());
            } catch (e) {}
          }
        }
      }
    });

    normalizeBadgeContrast();
    removeCardDiscountCounters();
  }
  // Support for Astro Page Transitions
  document.addEventListener("astro:after-swap", () => {
    initPricing();
    updateDynamicPrices();
    initPriceAutoRefresh();
    initCheckoutPopup();
    initMobileNavigation();
  });
</script>

