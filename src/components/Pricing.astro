---
import PromoCountdown from "./PromoCountdown";
---

<section id="planos" class="py-24 bg-brand-light relative z-20 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center mb-16">
      <div
        class="inline-flex items-center justify-center bg-brand-yellow/10 border border-brand-yellow/30 text-brand-yellow px-4 py-1.5 rounded-full text-xs font-black tracking-wide uppercase mb-6 shadow-[0_0_20px_rgba(255,184,0,0.2)]"
      >
        Oferta de Aniversário
      </div>
      <h2
        class="text-4xl md:text-6xl font-black text-brand-dark mb-4 tracking-tight"
      >
        Escolha seu plano Ratoeira
      </h2>
      <p class="text-lg text-brand-text/70 max-w-2xl mx-auto mb-10">
        O bueiro está aberto. Garanta sua proteção agora.
      </p>

      <div
        class="w-screen relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw] mb-12 px-4 md:px-8"
      >
        <PromoCountdown client:visible />
      </div>

      <!-- Step 1: Oferta Selector -->
      <div class="flex flex-col items-center mb-10">
        <span
          class="text-[10px] uppercase font-black text-brand-text/30 tracking-[0.2em] mb-4"
          >ETAPA 1 — SELECIONE SUA ESTRATÉGIA</span
        >
        <div
          class="bg-gray-100 p-1.5 rounded-3xl flex gap-1 border border-black/5 shadow-inner w-full max-w-2xl mx-auto"
        >
          <button
            data-bundle-trigger="ads"
            class="bundle-btn flex-1 py-4 px-6 rounded-2xl text-sm font-black transition-all duration-300"
          >
            ADS
          </button>
          <button
            data-bundle-trigger="combo"
            class="bundle-btn active flex-1 py-4 px-6 rounded-2xl text-sm font-black transition-all duration-300 relative group"
          >
            Combo ADS + PAGES
            <span
              class="absolute -top-3 -right-3 bg-red-600 text-white text-[9px] px-2 py-1 rounded-full animate-bounce shadow-lg uppercase font-black"
              >Melhor Valor</span
            >
          </button>
          <button
            data-bundle-trigger="pages"
            class="bundle-btn flex-1 py-4 px-6 rounded-2xl text-sm font-black transition-all duration-300"
          >
            PAGES
          </button>
        </div>
      </div>

      <!-- Step 2: Period Selector -->
      <div class="flex flex-col items-center mb-16 px-4 md:px-0">
        <span
          class="text-[10px] uppercase font-black text-brand-text/30 tracking-[0.2em] mb-4"
          >ETAPA 2 — DEFINA O PERÍODO</span
        >
        <div
          class="bg-white p-1 rounded-full flex gap-0.5 border border-brand-yellow/20 shadow-sm w-full max-w-xs md:w-auto md:max-w-none"
        >
          <button
            data-period-trigger="anual"
            class="period-btn active flex-1 md:flex-none px-2 md:px-8 py-2.5 rounded-full text-[10px] md:text-xs font-black uppercase tracking-tight md:tracking-widest transition-all duration-300"
          >
            Anual
          </button>
          <button
            data-period-trigger="semestral"
            class="period-btn flex-1 md:flex-none px-2 md:px-8 py-2.5 rounded-full text-[10px] md:text-xs font-black uppercase tracking-tight md:tracking-widest transition-all duration-300"
          >
            Semestral
          </button>
          <button
            data-period-trigger="mensal"
            class="period-btn flex-1 md:flex-none px-2 md:px-8 py-2.5 rounded-full text-[10px] md:text-xs font-black uppercase tracking-tight md:tracking-widest transition-all duration-300"
          >
            Mensal
          </button>
          <button
            data-period-trigger="vitalicio"
            class="period-btn flex-1 md:flex-none px-2 md:px-8 py-2.5 rounded-full text-[10px] md:text-xs font-black uppercase tracking-tight md:tracking-widest transition-all duration-300"
          >
            Vitalício
          </button>
        </div>
      </div>
    </div>

    <!-- Pricing Content -->
    <div class="pricing-content relative min-h-[600px]">
      <!-- Indicador de Slide Mobile -->
      <div
        class="md:hidden flex items-center justify-center gap-2 mb-6 text-brand-dark/40 font-black text-[10px] uppercase tracking-[0.2em] animate-pulse"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg
        >
        <span>Deslize para os lados para ver mais</span>
      </div>

      <!-- Setas de Navegação Mobile -->
      <button 
        id="pricing-prev"
        class="md:hidden absolute left-0 top-[40%] -translate-y-1/2 z-30 w-11 h-11 bg-white/95 backdrop-blur-sm border border-brand-yellow/30 text-brand-dark rounded-full shadow-xl flex items-center justify-center transition-all opacity-20 pointer-events-none active:scale-90"
        aria-label="Anterior"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M15 19l-7-7 7-7"></path></svg>
      </button>
      <button 
        id="pricing-next"
        class="md:hidden absolute right-0 top-[40%] -translate-y-1/2 z-30 w-11 h-11 bg-white/95 backdrop-blur-sm border border-brand-yellow/30 text-brand-dark rounded-full shadow-xl flex items-center justify-center transition-all opacity-20 pointer-events-none active:scale-90"
        aria-label="Próximo"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"></path></svg>
      </button>

      <!-- BUNDLE: ADS ONLY -->
      <div
        data-bundle-group="ads"
        class="bundle-group transition-all duration-500"
      >
        <!-- Period: Anual (Ads Only) -->
        <div
          data-period-group="anual"
          class="period-group flex md:grid overflow-x-auto md:overflow-visible snap-x snap-mandatory scroll-smooth hide-scrollbar grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto items-stretch auto-rows-fr transition-all duration-500 font-black px-4 md:px-0 pb-8"
