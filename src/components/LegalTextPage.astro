---
import Layout from "../layouts/Layout.astro";

interface Props {
  title: string;
  product: string;
  text: string;
}

const { title, product, text } = Astro.props;
const paragraphs = text.trim().split(/\n\s*\n/).slice(1);
---

<Layout title={`${title} | ${product}`}>
  <main class="min-h-screen bg-brand-light px-4 py-12 text-brand-dark md:py-20">
    <div class="mx-auto max-w-4xl">
      <a href="/" class="text-sm font-bold underline underline-offset-4 hover:text-brand-dark/70">← Voltar para a página inicial</a>
      <header class="mt-10 border-b border-brand-dark/15 pb-8">
        <p class="text-xs font-black uppercase tracking-[0.2em] text-brand-dark/55">{product}</p>
        <h1 class="mt-3 text-3xl font-black tracking-tight md:text-5xl">{title}</h1>
      </header>
      <article class="mt-8 space-y-5 text-sm leading-7 text-brand-dark/85 md:text-base md:leading-8">
        {paragraphs.map((paragraph) => {
          const section = paragraph.match(/^(\d+)\n([^\n]+)\n([\s\S]+)$/);
          if (section) return <section><h2 class="mb-2 text-xl font-black text-brand-dark">{section[1]}. {section[2]}</h2><p class="whitespace-pre-line">{section[3]}</p></section>;
          const contractSection = paragraph.match(/^(\d+\.\s+[^\n]+)\n([\s\S]+)$/);
          if (contractSection) return <section><h2 class="mb-2 text-xl font-black text-brand-dark">{contractSection[1]}</h2><p class="whitespace-pre-line">{contractSection[2]}</p></section>;
          if (/^\d+\.\s+[^\n]+$/.test(paragraph)) return <h2 class="pt-4 text-xl font-black text-brand-dark">{paragraph}</h2>;
          return <p class="whitespace-pre-line">{paragraph}</p>;
        })}
      </article>
    </div>
  </main>
</Layout>
